        "expected_message": "密码错误"
    },
    {
        "case_name": "空密码",
        "username": "admin",
        "password": "",
        "expected_status": 401,
        "expected_code": 1,
        "expected_message": "密码错误"
    },
    {
        "case_name": "异常用户名",
        "username": "这里放21个字符",
        "password": "123456",
        "expected_status": 400,
        "expected_code": 1,
        "expected_message": "用户名长度超过限制"
}
