[
    {
        "case_name": "正确密码",
        "username": "admin",
        "password": "123456",
        "expected_status": 200,
        "expected_code": 0,
        "expected_message": "登录成功"

    },
    {
        "case_name": "错误密码",
        "username": "admin",
        "password": "wrong",
        "expected_status": 401,
